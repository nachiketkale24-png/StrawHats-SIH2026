# FastAPI address reachable from the phone running Expo Go.
# Replace this with your computer's Wi-Fi IPv4 address.
# Optional fallback when Expo cannot detect a LAN host (for example, tunnel mode).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.15:8000

# Native keys: enable Maps SDK for Android / Maps SDK for iOS.
# Restrict each key to its platform application identity.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
